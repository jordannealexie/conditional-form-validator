# Environment Configuration Template
# Copy this file to .env and update with your values

# API Settings
API_V1_STR=/api/v1
PROJECT_NAME="FastAPI RBAC/ABAC/ReBAC Project"

# Security
SECRET_KEY=your-secret-key-change-in-production-use-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fastapi_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost/fastapi_db

# Database Connection Pool Settings (Performance Optimization)
DB_POOL_SIZE=20              # Base connection pool size
DB_MAX_OVERFLOW=10           # Additional connections under load
DB_POOL_TIMEOUT=30           # Connection timeout in seconds
DB_POOL_RECYCLE=3600         # Recycle connections every hour
DB_ECHO=false                # Disable SQL query logging (set true for debugging)

# Redis Cache Configuration (Performance Optimization)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Cache Settings
CACHE_ENABLED=true           # Enable/disable Redis caching
CACHE_DEFAULT_TTL=3600       # Default cache TTL (1 hour)
CACHE_TEMPLATE_TTL=3600      # Template cache TTL (1 hour)
CACHE_ENUM_TTL=86400         # Enum/reference data cache TTL (24 hours)

# Logging Configuration
LOG_LEVEL=INFO               # DEBUG, INFO, WARNING, ERROR
LOG_FORMAT=json              # "json" for production, "text" for development

# Metrics & Monitoring
METRICS_ENABLED=true         # Enable Prometheus metrics

# CORS
BACKEND_CORS_ORIGINS=["*"]   # Adjust for production (specific origins)

# File Upload
UPLOAD_DIR=uploads           # Directory for file uploads (fallback for local storage)

# MinIO Object Storage Configuration (Recommended for Production)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=uploads
MINIO_SECURE=false           # Set to true for HTTPS connections

# Client IDs (for custom middleware if enabled)
CLIENT_IDS=client1,client2,web-app
